# Application
APP_NAME=Health Dashboard API
APP_VERSION=1.0.0
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# CORS — JSON array, empty disables the middleware entirely
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=false

# Postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=health-dashboard-service

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Garmin
GARMIN_MFA_SESSION_TTL_SECONDS=300

# Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/strava-callback
STRAVA_UI_REDIRECT_URL=http://localhost:5173/settings/strava
STRAVA_SCOPE=["read","activity:read_all"]
STRAVA_STATE_TTL_SECONDS=300
