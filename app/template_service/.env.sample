# Application
APP_NAME=Template Service API
APP_VERSION=1.0.0
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# CORS — JSON array, empty disables the middleware entirely
CORS_ALLOW_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=false

# Postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=template-service

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false
